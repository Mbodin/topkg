{
  "name": "topkg",
  "version": "2.0",
  "description": "The transitory OCaml software packager",
  "authors": "The topkg programmers",
  "license": "ISC",
  "esy": {
    "build": "ocaml pkg/pkg.ml build --pkg-name topkg --dev-pkg topkg-dev",
		"buildEnv": {
			"OCAMLTOP_INCLUDE_PATH": "#{@opam/ocamlfind.install}:#{ocaml.toplevel}:#{ocaml.lib}",
			"OCAML_TOPLEVEL_PATH": "#{@opam/ocamlfind.install}:#{ocaml.toplevel}:#{ocaml.lib}"
		}
  },
  "dependencies": {
    "@opam/ocamlfind": ">= 1.6.1",
    "@opam/ocamlbuild": "*",
    "ocaml": ">= 4.08.0"
  }
}

